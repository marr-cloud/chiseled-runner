#!/bin/sh
# sudo for the -full images. Not a real sudo: it never raises privileges.
#
# Workflows written for myoung34 or ubuntu-latest run `sudo apt-get install`.
# - As root (RUN_AS_ROOT=true), this runs the command, as sudo would.
# - As the runner user, it lets `apt-get update` and installing packages the
#   image already has pass (so the same workflow runs unchanged on an image
#   built FROM -full with them), and refuses everything else.
set -eu

refuse() {
  echo "sudo: $*" >&2
  exit 1
}
usage="usage: sudo [-EHnkSv] [-u root] [--] COMMAND [ARGS...]"

home="" validate="" reset=""
while [ $# -gt 0 ]; do
  case "$1" in
    --preserve-env | --preserve-env=*) shift ;;
    --set-home) home=1; shift ;;
    -u)
      [ $# -ge 2 ] || refuse "-u needs a user"
      case "$2" in root | 0) shift 2 ;; *) refuse "only -u root is supported (got '$2')" ;; esac
      ;;
    --) shift; break ;;
    -?*)
      # Flags, alone or clustered (-EH).
      flags=${1#-}
      case "$flags" in *[!EHnkSv]*) refuse "option '$1' is not supported by this image's sudo" ;; esac
      case "$flags" in *H*) home=1 ;; esac
      case "$flags" in *v*) validate=1 ;; esac
      case "$flags" in *k*) reset=1 ;; esac
      shift
      ;;
    *) break ;;
  esac
done

if [ $# -eq 0 ]; then
  # sudo -v checks for root access; sudo -k forgets cached credentials.
  if [ -n "$validate" ]; then
    [ "$(id -u)" = 0 ] || refuse "jobs on this runner run as uid $(id -u), not root"
    exit 0
  fi
  [ -n "$reset" ] && exit 0
  refuse "$usage"
fi

if [ "$(id -u)" = 0 ]; then
  [ -z "$home" ] || export HOME=/root
  # env: like sudo, accept VAR=value assignments before the command.
  exec env "$@"
fi

# VAR=value assignments (DEBIAN_FRONTEND=noninteractive...) change nothing
# about what is checked below.
while [ $# -gt 0 ]; do
  case "$1" in [A-Za-z_]*=*) shift ;; *) break ;; esac
done
[ $# -gt 0 ] || refuse "$usage"

# installed PKG [VERSION]: PKG (with or without :arch) is installed, at
# VERSION if given. Held packages count.
installed() {
  st=$(dpkg-query -W -f='${Status} ${Version}' "$1" 2>/dev/null) || st=""
  case "$st" in
    "install ok installed "* | "hold ok installed "*) ;;
    *)
      # dpkg knows Architecture: all packages without an arch qualifier
      # (ca-certificates:amd64 is ca-certificates).
      case "$1" in *:*) ;; *) return 1 ;; esac
      [ "$(dpkg-query -W -f='${Architecture}' "${1%%:*}" 2>/dev/null)" = all ] || return 1
      installed "${1%%:*}" "${2:-}"
      return
      ;;
  esac
  [ -z "${2:-}" ] || [ "${st##* }" = "$2" ]
}

case "$1" in
  apt-get | apt)
    tool=$1
    shift
    # Options may come before the subcommand (apt-get -qq update, -y install).
    # -o, -t and -c take a value as the next argument; their values are not
    # packages either.
    sub="" pkgs="" skip=""
    for arg in "$@"; do
      if [ -n "$skip" ]; then skip=""; continue; fi
      case "$arg" in
        -o | -t | -c | --option | --target-release | --default-release | --config-file) skip=1 ;;
        -*) ;;
        *) if [ -z "$sub" ]; then sub=$arg; else pkgs="$pkgs $arg"; fi ;;
      esac
    done
    case "$sub" in
      update)
        echo "sudo: jobs run as uid $(id -u), not root: skipping '$tool update'" >&2
        exit 0
        ;;
      install)
        missing="" have=""
        set -f  # no globbing of package names
        # shellcheck disable=SC2086 # one word per package
        set -- $pkgs
        for arg in "$@"; do
          case "$arg" in
            *.deb)
              # A local package file: installed if dpkg has that package at
              # that version.
              name=$(dpkg-deb -f "$arg" Package 2>/dev/null) || name=""
              arch=$(dpkg-deb -f "$arg" Architecture 2>/dev/null) || arch=""
              version=$(dpkg-deb -f "$arg" Version 2>/dev/null) || version=""
              [ "$arch" = all ] || name="$name:$arch"
              if [ -n "$version" ] && installed "$name" "$version"; then ok=1; else ok=""; fi
              ;;
            *)
              # pkg, pkg:arch, pkg=version, pkg/release.
              name=${arg%%=*} name=${name%%/*} version=""
              case "$arg" in *=*) version=${arg#*=} ;; esac
              if installed "$name" "$version"; then ok=1; else ok=""; fi
              ;;
          esac
          if [ -n "$ok" ]; then have="$have $arg"; else missing="$missing $arg"; fi
        done
        if [ -z "$missing" ]; then
          echo "sudo: already installed:${have}" >&2
          exit 0
        fi
        ;;
    esac
    ;;
esac

cat >&2 <<MSG
sudo: jobs on this runner run as uid $(id -u), not root, and this image's sudo
cannot raise privileges${missing:+ (missing:${missing})}. Either:
  - start the runner with RUN_AS_ROOT=true (jobs run as root, as on
    myoung34; they can then read the runner's credentials), or
  - build an image FROM this one with the packages installed:
      FROM meitrix8208/chiseled-runner:<release>-full
      RUN apt-get update && apt-get install -y --no-install-recommends <packages>
See https://github.com/marr-cloud/chiseled-runner/blob/main/docs/Building-and-extending.md#when-chisel-is-not-enough
MSG
exit 1
